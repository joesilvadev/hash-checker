# Copia este archivo a `.env.local` y rellena las claves.
# `.env.local` está en .gitignore: NUNCA lo subas al repositorio.

# abuse.ch — una única clave sirve para MalwareBazaar, ThreatFox y URLhaus.
# Regístrate gratis en https://auth.abuse.ch/ y copia tu Auth-Key.
ABUSECH_AUTH_KEY=

# VirusTotal API pública (gratuita, no comercial): 500 peticiones/día, 4 por minuto.
# Consíguela en https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Hybrid Analysis (Falcon Sandbox) — clave gratuita previo registro.
# Consíguela en https://www.hybrid-analysis.com/ > perfil > API key.
HYBRID_ANALYSIS_API_KEY=

# AlienVault OTX — OPCIONAL. Funciona sin clave (1.000 req/h); con clave, 10.000 req/h.
# Consíguela en https://otx.alienvault.com/api
OTX_API_KEY=